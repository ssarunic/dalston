# Base image for NeMo-based engines
#
# Contains: PyTorch 2.12 (pinned) + nemo_toolkit[asr] 3.0 + common audio deps
# Rebuild: only when NeMo or torch version changes (rare)
#
# Used by: nemo transcribe, nemo-sortformer (NeMo 3.0, the default)
#          nemo-msdd via the dalston/base-nemo-2.7 variant (see build-bases):
#          MSDD's NeuralDiarizer was removed in NeMo 3.0.
#
# Build from repo root:
#   CPU:  docker build -f docker/Dockerfile.base-nemo -t dalston/base-nemo:latest .
#   GPU:  docker build --build-arg DEVICE=cuda -f docker/Dockerfile.base-nemo -t dalston/base-nemo:latest .
#   2.7:  docker build --build-arg NEMO_SPEC=">=2.7.3,<2.8.0" --build-arg TORCH_VERSION=2.13.0 \
#             -f docker/Dockerfile.base-nemo -t dalston/base-nemo-2.7:latest .

ARG DEVICE=cpu

# --- CPU base ---
FROM python:3.13-slim AS base-cpu

# --- GPU base ---
FROM nvidia/cuda:12.9.2-runtime-ubuntu24.04 AS base-cuda
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# --- Common ---
FROM base-${DEVICE} AS base
ARG DEVICE=cpu
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# PyTorch — CPU wheels for CPU builds, PyPI (CUDA 13 pip libs) for GPU builds.
#
# Pinned on purpose. NeMo only declares torch>=2.6, so an unpinned build
# resolves whatever torch shipped that week (2.13 on 2026-08-05, 2.14 on
# 2026-09-03) and every image rebuild silently changes the GPU stack that
# production pulls at boot. 2.12.0 is the torch NeMo 3.0 itself pins in its
# cu12/cu13 extras (torch==2.12.0+cu126 / +cu132); the plain PyPI 2.12.0
# wheel ships the CUDA 13 pip libraries. Bump deliberately and re-run the
# L4 VRAM calibration before shipping (the L4 numbers move with the torch
# build).
ARG TORCH_VERSION=2.12.0
ARG TORCHAUDIO_VERSION=2.11.0
RUN if [ "$DEVICE" = "cpu" ]; then \
        pip install --no-cache-dir --break-system-packages \
            "torch==${TORCH_VERSION}" "torchaudio==${TORCHAUDIO_VERSION}" \
            --index-url https://download.pytorch.org/whl/cpu; \
    else \
        pip install --no-cache-dir --break-system-packages \
            "torch==${TORCH_VERSION}" "torchaudio==${TORCHAUDIO_VERSION}"; \
    fi

# NeMo toolkit (the heavy part — ~2GB with all ASR deps).
# 3.0 is the speech-only NeMo (LLM/VLM/NLP collections moved out). It drops
# the protobuf~=5.29 and transformers~=4.57 pins 2.7.x carried, and removes
# the MSDD NeuralDiarizer (nemo-msdd was retired with this bump; Sortformer
# is its successor). The cache-aware streaming API the realtime path uses
# (conformer_stream_step / CacheAwareStreamingAudioBuffer) is unchanged.
#
# NEMO_SPEC exists only so nemo-msdd can keep a 2.7.x base until it is
# retired; every other consumer uses the default.
ARG NEMO_SPEC=">=3.0.0,<3.1.0"
RUN pip install --no-cache-dir --break-system-packages \
    "nemo_toolkit[asr]${NEMO_SPEC}"

# Common audio processing deps
RUN pip install --no-cache-dir --break-system-packages \
    "soundfile>=0.12.0" \
    "numpy>=1.22.0,<3.0.0" \
    "librosa>=0.10.1"

# Silero VAD — baked ONNX file (for realtime streaming VAD and the
# VadChunker's onnxruntime fallback) AND the silero-vad Python package
# (preferred loader path for the base-engine batch chunker in M86).
# Keeping both means the batch chunker works fully offline whether the
# worker reaches the pip package first or falls through to the ONNX
# file via DALSTON_SILERO_VAD_ONNX.
#
# M100.6: the URL tag and the pin below must stay on the SAME release,
# and the pin is exact for that reason. The two backends load different
# artifacts (the package's TorchScript weights vs this ONNX export) and
# are only the same model when both come from one tag — v5.1.2 and
# v6.2.1 differ in both, despite the ONNX having an identical byte size.
# Mismatch silently changes speech probabilities and endpointing
# depending on which backend wins. tests/unit/test_silero_vad_shared.py
# enforces the alignment.
RUN mkdir -p /models/silero-vad \
    && python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/snakers4/silero-vad/raw/v6.2.1/src/silero_vad/data/silero_vad.onnx', '/models/silero-vad/silero_vad.onnx')"
ENV DALSTON_SILERO_VAD_ONNX=/models/silero-vad/silero_vad.onnx
RUN pip install --no-cache-dir --break-system-packages "silero-vad==6.2.1"

# Model cache
ENV HF_HOME=/models/huggingface
ENV TORCH_HOME=/models/torch
ENV NEMO_CACHE=/models/nemo
RUN mkdir -p /models/huggingface /models/torch /models/nemo

ENV NVIDIA_VISIBLE_DEVICES=all
