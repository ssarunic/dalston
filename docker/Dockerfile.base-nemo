# Base image for NeMo-based engines
#
# Contains: PyTorch + nemo_toolkit[asr] 2.7 + common audio deps
# Rebuild: only when NeMo version changes (rare)
#
# Used by: nemo transcribe, nemo-msdd, nemo-sortformer
#
# Build from repo root:
#   CPU:  docker build -f docker/Dockerfile.base-nemo -t dalston/base-nemo:latest .
#   GPU:  docker build --build-arg DEVICE=cuda -f docker/Dockerfile.base-nemo -t dalston/base-nemo:latest .

ARG DEVICE=cpu

# --- CPU base ---
FROM python:3.13-slim AS base-cpu

# --- GPU base ---
FROM nvidia/cuda:12.9.2-runtime-ubuntu24.04 AS base-cuda
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# --- Common ---
FROM base-${DEVICE} AS base
ARG DEVICE=cpu
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# PyTorch — CPU wheels for CPU builds, system CUDA for GPU builds
RUN if [ "$DEVICE" = "cpu" ]; then \
        pip install --no-cache-dir --break-system-packages \
            torch torchaudio --index-url https://download.pytorch.org/whl/cpu; \
    fi

# NeMo toolkit (the heavy part — ~2GB with all ASR deps)
RUN pip install --no-cache-dir --break-system-packages \
    "nemo_toolkit[asr]>=2.7.0,<2.8.0"

# Common audio processing deps
RUN pip install --no-cache-dir --break-system-packages \
    "soundfile>=0.12.0" \
    "numpy>=1.22.0,<3.0.0" \
    "librosa>=0.10.1"

# Silero VAD — baked ONNX file (for realtime streaming VAD and the
# VadChunker's onnxruntime fallback) AND the silero-vad Python package
# (preferred loader path for the base-engine batch chunker in M86).
# Keeping both means the batch chunker works fully offline whether the
# worker reaches the pip package first or falls through to the ONNX
# file via DALSTON_SILERO_VAD_ONNX.
#
# M100.6: the URL tag and the pin below must stay on the SAME release,
# and the pin is exact for that reason. The two backends load different
# artifacts (the package's TorchScript weights vs this ONNX export) and
# are only the same model when both come from one tag — v5.1.2 and
# v6.2.1 differ in both, despite the ONNX having an identical byte size.
# Mismatch silently changes speech probabilities and endpointing
# depending on which backend wins. tests/unit/test_silero_vad_shared.py
# enforces the alignment.
RUN mkdir -p /models/silero-vad \
    && python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/snakers4/silero-vad/raw/v6.2.1/src/silero_vad/data/silero_vad.onnx', '/models/silero-vad/silero_vad.onnx')"
ENV DALSTON_SILERO_VAD_ONNX=/models/silero-vad/silero_vad.onnx
RUN pip install --no-cache-dir --break-system-packages "silero-vad==6.2.1"

# Model cache
ENV HF_HOME=/models/huggingface
ENV TORCH_HOME=/models/torch
ENV NEMO_CACHE=/models/nemo
RUN mkdir -p /models/huggingface /models/torch /models/nemo

ENV NVIDIA_VISIBLE_DEVICES=all
