# Base image for pyannote 4.0 diarization engine
#
# Contains: CUDA runtime + PyTorch (CUDA wheels) + pyannote.audio 4.0
# Rebuild: only when pyannote or PyTorch version changes (rare)
#
# Note: torchcodec (required by pyannote 4.0) only has x86_64 Linux wheels,
# so this image must be built for linux/amd64 platform on ARM Macs.
#
# Build from repo root:
#   CPU:  docker build -f docker/Dockerfile.base-pyannote -t dalston/base-pyannote:latest .
#   GPU:  docker build --build-arg DEVICE=cuda -f docker/Dockerfile.base-pyannote -t dalston/base-pyannote:latest .

ARG DEVICE=cpu

# --- CPU base ---
FROM --platform=linux/amd64 python:3.13-slim AS base-cpu

# --- GPU base ---
FROM --platform=linux/amd64 nvidia/cuda:12.9.2-runtime-ubuntu24.04 AS base-cuda
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# --- Common ---
FROM base-${DEVICE} AS base
ARG DEVICE=cpu
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

# PyTorch + pyannote.audio (the heavy part — 2-3GB)
#
# Pinned to exact +cu126 builds on purpose. pip picks the highest version
# across ALL indexes, so a range like "torchaudio>=2.11,<2.12" with the
# cu126 index as an extra index is a trap: on 2026-10-28 PyPI published
# torchaudio 2.11.1 as a py3-none wheel built against CUDA 13 (2.11.1+cu132,
# links libcudart.so.13). 2.11.1 outranks 2.11.0+cu126, so the next rebuild
# shipped a CUDA-13 torchaudio on a CUDA-12 torch and every diarize task
# died with "Could not load this library: .../_torchaudio.so". A "+cu126"
# local version can only be satisfied by the PyTorch index, so PyPI can
# never outrank it again. torch + torchcodec must also match ABI
# (torchcodec 0.10 vs torch 2.11 gives undefined c10::MessageLogger).
# Bump all three together, from the cu126 index only.
RUN if [ "$DEVICE" = "cuda" ]; then \
        pip install --no-cache-dir --break-system-packages \
            --extra-index-url https://download.pytorch.org/whl/cu126 \
            "torch==2.11.0+cu126" "torchaudio==2.11.0+cu126" \
            "torchcodec==0.11.1+cu126" \
            "pyannote.audio>=4.0.0,<5.0.0" \
            "huggingface_hub>=1.0.0"; \
    else \
        pip install --no-cache-dir --break-system-packages \
            "torch==2.11.0" "torchaudio==2.11.0" \
            "torchcodec==0.11.1" \
            "pyannote.audio>=4.0.0,<5.0.0" \
            "huggingface_hub>=1.0.0"; \
    fi

# Silero VAD — this image previously shipped no VAD provisioning at all
# (no package, no baked ONNX, no onnxruntime), so a realtime engine
# landing here would raise at session start. The silero-vad package
# carries the TorchScript weights (~8 MB, pure Python) and is what
# load_silero_model() selects on a torch image; no onnxruntime needed.
RUN pip install --no-cache-dir --break-system-packages "silero-vad==6.2.1"

# Model cache
ENV HF_HOME=/models/huggingface
ENV TORCH_HOME=/models/torch
RUN mkdir -p /models/huggingface /models/torch

ENV NVIDIA_VISIBLE_DEVICES=all
