<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dalston FluidAudio Mac worker (M104): the diarize adapter (engine_id
  fluidaudio-pyannote). Rendered by install.sh. Metrics port 9101 is set by
  run-adapter.sh so it never collides with the transcribe adapter's 9100.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dalston.fluidaudio-diarize</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_DIR__/engines/stt-transcribe/fluidaudio/mac/run-adapter.sh</string>
    <string>diarize</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DALSTON_HOME</key>
    <string>__DALSTON_HOME__</string>
    <key>DALSTON_REPO_DIR</key>
    <string>__REPO_DIR__</string>
    <key>PATH</key>
    <!-- Homebrew first so the SDK finds ffmpeg; launchd does not read the shell profile. -->
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__/engines/stt-diarize/fluidaudio</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/fluidaudio-diarize.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/fluidaudio-diarize.log</string>
</dict>
</plist>
