# Dalston FluidAudio Mac worker (M104)
#
# Copy to ~/.dalston/fluidaudio/worker.env and edit. Plain KEY=value lines
# only: this file is read by run-adapter.sh with `set -a; source`, and by
# nothing that expands $(...) for you.

# --- Control plane -----------------------------------------------------------
# Tailscale MagicDNS name (or IP) of the control plane host.
REDIS_URL=redis://dalston-control-plane:6379
DALSTON_S3_BUCKET=dalston-artifacts-CHANGE-ME
DALSTON_S3_REGION=eu-west-2
AWS_REGION=eu-west-2
# For a local `make dev` control plane (MinIO) instead of AWS S3, set the
# control plane's Tailscale IP here and use the MinIO keys as the profile:
# DALSTON_S3_ENDPOINT_URL=http://100.64.0.10:9000

# AWS credentials: a named profile in ~/.aws/credentials for an IAM user
# scoped to the artifact bucket only. Never the account admin key.
AWS_PROFILE=dalston-worker

# --- Identity (shows on the console's Infrastructure page) -------------------
# generate_instance_id() keeps the first 12 characters of DALSTON_WORKER_ID,
# so keep it short. run-adapter.sh appends a per-stage suffix.
DALSTON_WORKER_ID=studio
DALSTON_HOST_HOSTNAME=studio
DALSTON_DEPLOY_ENV=mac

# --- Engine behaviour --------------------------------------------------------
DALSTON_FLUIDAUDIO_URL=http://127.0.0.1:9200
DALSTON_FLUIDAUDIO_TIMEOUT_S=7200
# Transcribe default model; one of the FluidAudio repo ids the server serves.
# The diarize adapter ignores this and uses the speaker-diarization repo.
DALSTON_DEFAULT_MODEL=FluidInference/parakeet-tdt-0.6b-v3-coreml
DALSTON_LOG_FORMAT=json
DALSTON_LOG_LEVEL=INFO

# --- Server (read by fluidaudio-server, not the adapters) --------------------
FLUIDAUDIO_HOST=127.0.0.1
FLUIDAUDIO_PORT=9200
# Warm start so the first task does not pay download + Core ML compile.
FLUIDAUDIO_PRELOAD_ASR=FluidInference/parakeet-tdt-0.6b-v3-coreml
FLUIDAUDIO_PRELOAD_DIARIZER=1

# --- Observability (only if the control plane runs the observability profile)
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://dalston-control-plane:4317
# DALSTON_METRICS_ENABLED=true

# Deliberately NOT set:
#   DALSTON_BATCH_MAX_INFLIGHT / DALSTON_TOTAL_CAPACITY  (unified runners only;
#       the plain batch runner is single-task)
#   DALSTON_MODEL_SOURCE  (the adapters load no models)
#   HF_TOKEN  (FluidAudio's Core ML repos are not gated)
#   DALSTON_METRICS_PORT  (set per adapter by run-adapter.sh: 9100 / 9101)
